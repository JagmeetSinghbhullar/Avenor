# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Supabase
# No new variables needed for Google auth — NEXT_PUBLIC_SUPABASE_ANON_KEY
# (already below) is what the browser/server auth clients use. Google
# sign-in itself requires two one-time steps in your own dashboards, not
# in this file:
#   1. Supabase Dashboard -> Authentication -> Providers -> Google:
#      enable it and paste in a Google OAuth Client ID + Secret.
#   2. Google Cloud Console -> APIs & Services -> Credentials: create an
#      OAuth Client ID, with an Authorized redirect URI of
#      https://<your-project-ref>.supabase.co/auth/v1/callback
#      (that's Supabase's own callback, not this app's /auth/callback).
# Also add this app's own callback URL to Supabase's Authentication ->
# URL Configuration -> Redirect URLs allowlist:
#   http://localhost:3000/auth/callback   (local dev)
#   https://<your-vercel-domain>/auth/callback   (production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTrack
YOUTRACK_BASE_URL=
YOUTRACK_API_TOKEN=
YOUTRACK_PROJECT=
# Optional — name of the custom field holding ticket status. Defaults to "State"
# (YouTrack's default field name); only set this if your project renamed it.
YOUTRACK_STATE_FIELD=

# Slack
SLACK_INCOMING_WEBHOOK_URL=
