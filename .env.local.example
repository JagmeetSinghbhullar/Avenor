# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTrack
YOUTRACK_BASE_URL=
YOUTRACK_API_TOKEN=
YOUTRACK_PROJECT=
# Optional — name of the custom field holding ticket status. Defaults to "State"
# (YouTrack's default field name); only set this if your project renamed it.
YOUTRACK_STATE_FIELD=

# Slack
SLACK_INCOMING_WEBHOOK_URL=
