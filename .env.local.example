# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Supabase
# No new variables needed for Google auth — NEXT_PUBLIC_SUPABASE_ANON_KEY
# (already below) is what the browser/server auth clients use. Google
# sign-in itself requires two one-time steps in your own dashboards, not
# in this file:
#   1. Supabase Dashboard -> Authentication -> Providers -> Google:
#      enable it and paste in a Google OAuth Client ID + Secret.
#   2. Google Cloud Console -> APIs & Services -> Credentials: create an
#      OAuth Client ID, with an Authorized redirect URI of
#      https://<your-project-ref>.supabase.co/auth/v1/callback
#      (that's Supabase's own callback, not this app's /auth/callback).
# Also add this app's own callback URL to Supabase's Authentication ->
# URL Configuration -> Redirect URLs allowlist:
#   http://localhost:3000/auth/callback   (local dev)
#   https://<your-vercel-domain>/auth/callback   (production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# YouTrack — each user connects their own account from the Profile page;
# these vars are ONLY a local-development fallback for testing before you've
# connected a per-user integration, and only take effect when
# ENABLE_DEV_YOUTRACK_FALLBACK=true is also set (never used in production).
YOUTRACK_BASE_URL=
YOUTRACK_API_TOKEN=
YOUTRACK_PROJECT=
# Optional — name of the custom field holding ticket status. Defaults to "State"
# (YouTrack's default field name); only set this if your project renamed it.
YOUTRACK_STATE_FIELD=
# Opt-in switch for the fallback above. Leave unset/false to always see the
# normal "Connect your YouTrack account" state for unconnected users.
ENABLE_DEV_YOUTRACK_FALLBACK=

# Slack — each user connects their own webhook from the Profile page; this
# app never falls back to a shared webhook for sending reports.
SLACK_INCOMING_WEBHOOK_URL=
